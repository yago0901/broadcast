rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // O documento que já existe pertence ao usuário logado?
    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // O documento que está sendo criado declara o usuário logado como dono?
    function creatingOwn() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Campos que nunca podem mudar em um update
    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }
    function connectionUnchanged() {
      return request.resource.data.connectionId == resource.data.connectionId;
    }

    // A conexão informada existe e é do usuário logado?
    function ownsConnection(connectionId) {
      return get(/databases/$(database)/documents/connections/$(connectionId)).data.ownerId == request.auth.uid;
    }

    // Campos obrigatórios de uma mensagem (create e edição)
    function validMessage() {
      let data = request.resource.data;
      return data.text is string
          && data.text.size() > 0
          && data.text.size() <= 1000
          && data.contactIds is list
          && data.contactIds.size() > 0
          && data.status in ['scheduled', 'sent']
          && (data.status == 'sent' || data.scheduledAt is timestamp);
    }

    // Edição: só mensagens agendadas
    function isEditingScheduled() {
      return resource.data.status == 'scheduled' && validMessage();
    }

    // Exclusão lógica: agendada ou enviada, e só muda status e deletedAt
    function isSoftDeleting() {
      let data = request.resource.data;
      return resource.data.status in ['scheduled', 'sent']
          && data.status == 'deleted'
          && data.deletedAt == request.time
          && data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt']);
    }

    // ---------- Conexões ----------
    match /connections/{connectionId} {
      allow read, delete: if isOwner();
      allow create: if creatingOwn()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if isOwner() && ownerUnchanged()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
    }

    // ---------- Contatos ----------
    match /contacts/{contactId} {
      allow read, delete: if isOwner();
      allow create: if creatingOwn()
                    && ownsConnection(request.resource.data.connectionId)
                    && request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow update: if isOwner() && ownerUnchanged() && connectionUnchanged();
    }

    // ---------- Mensagens (registro: nunca são apagadas de verdade) ----------
    match /messages/{messageId} {
      allow read: if isOwner();

      allow create: if creatingOwn()
                    && ownsConnection(request.resource.data.connectionId)
                    && validMessage();

      // Edição só de agendadas; exclusão lógica de agendadas ou enviadas.
      // "deleted" é um estado final: depois dele nenhum update é aceito.
      allow update: if isOwner() && ownerUnchanged() && connectionUnchanged()
                    && (isEditingScheduled() || isSoftDeleting());

      allow delete: if false;
    }
  }
}